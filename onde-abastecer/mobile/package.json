{
  "name": "onde-abastecer-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build": "expo export --platform all",
    "postinstall": "node scripts/prepare-map.mjs",
    "prebuild": "node scripts/prepare-map.mjs",
    "build:apk": "node scripts/build-apk.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.17",
    "expo-build-properties": "~57.0.23",
    "expo-location": "~57.0.20",
    "leaflet": "^1.9.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  },
  "type": "module",
  "overrides": {
    "@expo/fingerprint": {
      "glob": "14.0.4",
      "minimatch": "11.0.5"
    }
  }
}
