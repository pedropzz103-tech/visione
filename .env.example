# Optional build-time TMDB integration. Never expose this token in browser JavaScript.
TMDB_READ_ACCESS_TOKEN=replace_with_a_tmdb_read_access_token
TMDB_API_BASE_URL=https://api.themoviedb.org/3
CATALOG_MAX_AGE_HOURS=24

# Optional future affiliate configuration. Empty means normal non-affiliate provider links.
AFFILIATE_CONFIG_PATH=
